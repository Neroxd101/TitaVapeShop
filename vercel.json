{
  "version": 2,
  "builds": [
    {
      "src": "main.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/main.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/main.js"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "/main.js"
    },
    {
      "src": "/inventory(.*)",
      "dest": "/main.js"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/main.js"
    }
  ]
}
